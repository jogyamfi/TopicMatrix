# Copy this file to .env for local development. Defaults below run T1 (Node + SQLite)
# with zero further configuration. See documents/planning/requirements.md §14.1.1.

# sqlite | postgresql | d1
DATABASE_PROVIDER=sqlite

# Required for sqlite/postgresql, unused for d1 (reached via binding instead).
DATABASE_URL=file:./dev.db

# development | production. Never set to a value that disables error detail suppression in prod.
NODE_ENV=development

# Node entrypoint only.
PORT=3000

# Comma-separated origin allow-list. Node entrypoint only; unused on Workers (same-origin).
CORS_ORIGINS=http://localhost:5173

# >= 32 chars. This is a DEVELOPMENT-ONLY placeholder - never reuse it anywhere real.
JWT_SECRET=dev-only-change-me-32-characters-min

# Argon2id parameters. Server-grade defaults for Node; tuned separately for Workers CPU limits.
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2

# debug | info | warn | error
LOG_LEVEL=debug

# Reverse proxies in front of the Node API whose X-Forwarded-For entries are trusted for the
# client IP (login rate limiting). 0 when clients connect directly (local dev); 1 behind the
# docker-compose nginx. Never set it higher than the real number of proxies — extra hops let a
# client choose its own IP.
TRUST_PROXY_HOPS=0
